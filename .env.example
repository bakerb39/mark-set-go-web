# Azure AI Translator settings
AZURE_TRANSLATOR_KEY=replace-with-your-key
AZURE_TRANSLATOR_REGION=eastus
# Usually this default is correct. A custom resource may supply a different endpoint.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Optional comma-separated HTTPS mirrors. The app tries each before the catalog URL.
GUTENBERG_MIRROR_BASES=https://gutenberg.pglaf.org,https://mirrors.xmission.com/gutenberg
